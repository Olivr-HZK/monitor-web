# 复制为 .env 并填写（也可沿用项目根目录或 server/.env 的变量名）
PORT=3001
JWT_SECRET=请改为随机长字符串
LOGIN_USERNAME=admin
# 生成哈希：python -c "from passlib.hash import bcrypt; print(bcrypt.hash('你的密码'))"
LOGIN_PASSWORD_HASH=

# 跨域（前端静态站域名，生产建议填写）
CORS_ORIGIN=*

# AI 对话（OpenRouter / OpenAI 等兼容接口）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=google/gemini-2.0-flash-001

# 玩法解析申请通知（可选）
FEISHU_WEBHOOK_URL=
WECOM_WEBHOOK_URL_REAL=
# 飞书媒体代理（可选）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_MEDIA_PUBLIC=false
