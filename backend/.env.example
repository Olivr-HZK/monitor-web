# 复制为 .env 并填写（也可沿用项目根目录或 server/.env 的变量名）
PORT=3001
JWT_SECRET=请改为随机长字符串
LOGIN_USERNAME=admin
# 生成哈希：python -c "from passlib.hash import bcrypt; print(bcrypt.hash('你的密码'))"
LOGIN_PASSWORD_HASH=

# 跨域（支持逗号分隔多个前端域名；需要登录态时不要写 *）
CORS_ORIGIN=http://localhost:5173,https://oliverxxx.github.io

# AI 对话（OpenRouter / OpenAI 等兼容接口）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# 示例（OpenRouter）：OPENAI_BASE_URL=https://openrouter.ai/api/v1
# 模型名需带厂商前缀，如 openai/gpt-4o、anthropic/claude-3.5-sonnet（以 OpenRouter 模型页为准）
OPENAI_MODEL=gpt-4.1-mini

# AI_PROVIDER=openai（仅对话，无工具）| codex（Codex 子进程+工具，勿配 OpenRouter base）| openrouter（OpenRouter + 多轮工具）
AI_PROVIDER=openai
# 可选：OpenRouter 文档建议的 Referer（站点 URL）
# OPENROUTER_HTTP_REFERER=https://localhost
# 使用 codex app-server 时启用
CODEX_APP_SERVER_BIN=codex
CODEX_MODEL=gpt-5.1-codex
# 可选：当项目目录含中文等非 ASCII 路径时，建议设为 ASCII 路径（如软链接目录）
CODEX_WORKDIR=
CODEX_TURN_TIMEOUT_SEC=180
CODEX_ENABLE_DB_TOOL=true
CODEX_ENABLE_WEB_SEARCH_TOOL=true
# 可选：Tavily 搜索 API Key（未配置时回退 DuckDuckGo）
TAVILY_API_KEY=

# 玩法解析申请通知（可选）
FEISHU_WEBHOOK_URL=
WECOM_WEBHOOK_URL_REAL=
# 飞书媒体代理（可选）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_MEDIA_PUBLIC=false
