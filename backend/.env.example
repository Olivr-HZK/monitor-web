# 复制为 .env 并填写（也可沿用项目根目录或 server/.env 的变量名）
PORT=3001
JWT_SECRET=请改为随机长字符串
LOGIN_USERNAME=admin
# 生成哈希：python -c "from passlib.hash import bcrypt; print(bcrypt.hash('你的密码'))"
LOGIN_PASSWORD_HASH=

# 跨域（支持逗号分隔多个前端；需要登录 Cookie 时不要写 *）
# 静态站（如 GitHub Pages）与 API 不同源时，必须把浏览器里实际 Origin 配进来（开发者工具 → Network → 失败请求 → Request Headers 的 Origin；本仓库 Pages 一般为 https://olivr-hzk.github.io）
# 公网静态站 + 独立 API 时：CORS_ORIGIN 须含静态页 Origin（无路径），如 https://olivr-hzk.github.io
# 本地开发可保留 localhost；逗号分隔多个
CORS_ORIGIN=https://olivr-hzk.github.io,http://localhost:5173,http://127.0.0.1:5173

# 静态站与 API 不同域时，登录 Cookie 需跨站传递：none + Secure（API 须为 HTTPS）
COOKIE_SAMESITE=none
COOKIE_SECURE=true

# AI 对话（OpenRouter / OpenAI 等兼容接口）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# 示例（OpenRouter）：OPENAI_BASE_URL=https://openrouter.ai/api/v1
# 模型名需带厂商前缀，如 openai/gpt-4o、anthropic/claude-3.5-sonnet（以 OpenRouter 模型页为准）
OPENAI_MODEL=gpt-4.1-mini

# AI_PROVIDER=openai（仅对话，无工具）| codex（Codex 子进程+工具，勿配 OpenRouter base）| openrouter（OpenRouter + 多轮工具）
AI_PROVIDER=openai
# 可选：OpenRouter 文档建议的 Referer（站点 URL）
# OPENROUTER_HTTP_REFERER=https://localhost
# 使用 codex app-server 时启用
CODEX_APP_SERVER_BIN=codex
CODEX_MODEL=gpt-5.1-codex
# 可选：当项目目录含中文等非 ASCII 路径时，建议设为 ASCII 路径（如软链接目录）
CODEX_WORKDIR=
CODEX_TURN_TIMEOUT_SEC=180
CODEX_ENABLE_DB_TOOL=true
CODEX_ENABLE_WEB_SEARCH_TOOL=true
# 可选：Tavily 搜索 API Key（未配置时回退 DuckDuckGo）
TAVILY_API_KEY=

# 玩法解析申请通知（可选）
FEISHU_WEBHOOK_URL=
WECOM_WEBHOOK_URL_REAL=
# 飞书媒体代理（可选）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_MEDIA_PUBLIC=false

# 飞书对话助手（可选）：建议使用独立飞书自建应用，避免和推送/多维表格应用混用
FEISHU_BOT_ENABLED=false
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
FEISHU_ALLOWED_OPEN_IDS=
FEISHU_ALLOWED_CHAT_IDS=
# 群聊里只有艾特这些机器人显示名才会响应；不要留空后用任意 @ 兜底
FEISHU_BOT_MENTION_NAMES=监测助手,飞书监测助手
FEISHU_ASSISTANT_SEND_THINKING=true
ASSISTANT_MAX_HISTORY_TURNS=10
