{
  "name": "-",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "https://olivr-hzk.github.io/monitor-web/",
  "scripts": {
    "dev": "vite",
    "dev:server": "cd server && npm run start",
    "dev:backend": "cd backend && python -m uvicorn main:app --reload --host 0.0.0.0 --port 3001",
    "dev:casual": "vite --open /casual.html",
    "build": "tsc -b && vite build",
    "build:staging": "tsc -b && vite build --mode staging",
    "start": "npm run build && node server/server.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "build:cf": "npm run build && node scripts/strip-sensitive-from-dist.js",
    "deploy:api": "npm run build && STRIP_DIST_DB=1 bash scripts/deploy.sh",
    "deploy": "bash scripts/deploy.sh",
    "deploy:staging": "npm run build:staging && bash scripts/deploy.sh -b gh-pages-staging"
  },
  "dependencies": {
    "@types/papaparse": "^5.5.2",
    "papaparse": "^5.5.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.0",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "gh": "^2.8.9",
    "gh-pages": "^6.3.0",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  }
}
