{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "packages": {
    "node": "20"
  },
  "steps": {
    "install": {
      "inputs": [
        { "step": "build" }
      ],
      "commands": [
        "cd server && npm install"
      ]
    }
  },
  "deploy": {
    "inputs": [
      {
        "step": "install",
        "include": ["."]
      }
    ],
    "startCommand": "cd server && node server.js"
  }
}
