# 复制为 .env 并填写
PORT=3001
JWT_SECRET=请改为随机长字符串
LOGIN_USERNAME=admin
# 运行 node hash-password.js 你的密码 生成哈希后填下面
LOGIN_PASSWORD_HASH=

# （可选）AI 对话使用的大模型配置，支持 OpenAI 兼容接口
# 必填：OpenAI 或兼容服务的 API Key
OPENAI_API_KEY=
# 可选：自定义 Base URL，例如自建代理 / DeepSeek / 通义等 OpenAI 兼容服务
# 默认 https://api.openai.com/v1
OPENAI_BASE_URL=
# 可选：模型名称，默认 gpt-4.1-mini，可改为 deepseek-chat 等
OPENAI_MODEL=gpt-4.1-mini
